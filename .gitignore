drafts/
.env
.env.*
!.env.example

# Python bytecode cache
__pycache__/
*.pyc

# Copyrighted YouTube transcripts — research leads only, never commit (see docs/video-research/README.md)
docs/video-research/_transcripts/

# Copyrighted article/essay PDFs — research leads only, never commit (see docs/article-research/README.md)
docs/article-research/_pdfs/

# ── Native app (Capacitor) build outputs ─────────────────────────────
# npm deps for the app toolchain (Capacitor CLI, RevenueCat, assets generator)
node_modules/
# Generated web bundle — rebuilt from source by `npm run build:app`, never hand-edited
app/www/
# Native build artifacts (regenerated by Gradle / Xcode; the project scaffolding IS committed)
android/build/
android/app/build/
android/.gradle/
android/local.properties
android/app/release/
android/app/src/main/assets/public/
android/capacitor-cordova-android-plugins/
ios/App/build/
ios/App/Pods/
ios/App/App/public/
ios/DerivedData/
**/.DS_Store
# Local RevenueCat keys — never commit real keys (see docs/APP_STORE.md).
# docs/APP_STORE.md tells the operator to create revenuecat.json at the REPO
# ROOT, so that exact path must be ignored (it would otherwise be committed AND
# served at apologiadaily.com/revenuecat.json).
revenuecat.json
app/revenuecat.json
app/revenuecat.local.json
!app/*.example.json

# App signing material — losing OR leaking these is unrecoverable
*.keystore
*.jks
key.properties
android/key.properties
google-services.json
GoogleService-Info.plist
*.p8
*.p12
*.mobileprovision
*.cer
