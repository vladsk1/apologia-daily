    { "name": "03-levels", "path": "/ev-m-kalam.html", "settle": 3000, "js": "await __go({text:'Your mastery of this argument'});" },
    { "name": "04-understand", "path": "/ev-m-kalam.html", "settle": 3000, "js": "await __go('#understand');" },
    { "name": "05-flash", "path": "/ev-m-kalam.html", "settle": 3000, "js": "await __go('#flash',120);" },
    { "name": "06-proveit", "path": "/ev-m-kalam.html", "settle": 3000, "js": "await __go('#proveit');" },
    { "name": "07-explain", "path": "/ev-m-kalam.html", "settle": 3000, "js": "await __go('#rq-explain',140);" }
