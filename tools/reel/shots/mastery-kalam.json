  "prep": "document.documentElement.style.scrollBehavior='auto';try{localStorage.setItem('ad-nocount','1')}catch(e){};window.__hideFloats=()=>{for(const el of document.querySelectorAll('body *')){const cs=getComputedStyle(el);if(cs.position==='fixed'&&el.getBoundingClientRect().top>90)el.style.visibility='hidden';}};window.__go=async(sel,off)=>{const e=typeof sel==='string'?document.querySelector(sel):[...document.querySelectorAll('h2,h3')].find(h=>h.textContent.trim().startsWith(sel.text));if(e){e.scrollIntoView({block:'start'});window.scrollBy(0,-(off||70));}await new Promise(r=>setTimeout(r,500));__hideFloats();};",
  "shots": [
